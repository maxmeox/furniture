{
  "name": "furniture-showroom-template",
  "version": "1.0.0",
  "private": true,
  "description": "White-label furniture showroom — Config-Driven Template",
  "packageManager": "npm@10.9.3",
  "scripts": {
    "dev": "next dev",
    "dev:build": "next build && next start",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:push": "prisma db push",
    "db:push:dev": "prisma db push",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:demo:clean": "tsx prisma/clean-demo.ts",
    "admin:reset-password": "tsx prisma/reset-admin-password.ts",
    "validate:tenant": "npx tsx scripts/validate-tenant.ts",
    "prebuild": "npm run validate:tenant",
    "preflight": "tsx scripts/preflight-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:code": "npm run lint && npm run typecheck && npm run build",
    "verify:local-light": "npm run verify:code && npm run preflight",
    "prepare": "husky"
  },
  "dependencies": {
    "@cline/sdk": "^0.0.53",
    "@next/third-parties": "^16.2.7",
    "@prisma/client": "^6.8.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-slot": "^1.2.2",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-tooltip": "^1.2.9",
    "@sentry/nextjs": "^10.57.0",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.511.0",
    "next": "^16.2.6",
    "next-intl": "^4.11.1",
    "nodemailer": "^9.0.1",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^3.8.1",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.7"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all",
      "not ie 11"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@next/bundle-analyzer": "^16.3.0-preview.0",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.17",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.3",
    "@types/react-dom": "^19.1.3",
    "@vitest/coverage-v8": "^3.2.6",
    "eslint": "^9.26.0",
    "eslint-config-next": "^16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.3",
    "prisma": "^6.8.0",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
}
