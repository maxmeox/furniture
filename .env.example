# =============================================================================
# FURNITURE SHOWROOM TEMPLATE — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# For Vercel, set these in your Vercel Dashboard (Settings → Environment Variables).


# -- Database ----------------------------------------------------------------
# Local development: use local PostgreSQL
# Vercel with Supabase: use the Transaction Pooler on port 6543 with:
#   pgbouncer=true&connection_limit=3&pool_timeout=30
# For Prisma schema/seed operations: use Supabase Session Pooler on port 5432.
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/furniture_production_v1?connection_limit=3"

# -- Admin Auth --------------------------------------------------------------
# Local seed/reset admin credentials. Change password after first login.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me-in-production"

# HMAC secret for signing admin session cookies. Must be ≥32 characters.
# Use: openssl rand -hex 32
ADMIN_SESSION_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Optional fallback for ADMIN_SESSION_SECRET (tried first).
AUTH_SECRET=""

# -- App Configuration -------------------------------------------------------
# Public absolute URL (used for metadata, sitemap, generated links, QR codes).
# Vercel: set to https://your-domain.vercel.app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Fallback WhatsApp number (digits only). Admin settings override this at runtime.
NEXT_PUBLIC_WHATSAPP_NUMBER="970528682975"

# -- Image Storage (Cloudinary) ----------------------------------------------
# Signed uploads for admin image management.
# CLOUDINARY_API_SECRET is server-only. Do NOT prefix with NEXT_PUBLIC_.
CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"
CLOUDINARY_API_KEY="your-cloudinary-api-key"
CLOUDINARY_API_SECRET="your-cloudinary-api-secret"
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloudinary-cloud-name"

# -- Lead Notifications (Email via SMTP) --------------------------------------
# Optional. If configured, the owner receives an email when a new lead arrives.
# Use any SMTP server (Gmail: smtp.gmail.com, port 587, app password).
# SMTP_HOST=""       # e.g. smtp.gmail.com
# SMTP_PORT=""       # e.g. 587 (TLS) or 465 (SSL)
# SMTP_USER=""       # your full email address
# SMTP_PASS=""       # app password (Gmail) or SMTP password
# NOTIFICATION_EMAIL=""  # where to send notifications (usually same as SMTP_USER)

# -- Rate Limiting (Upstash Redis) -------------------------------------------
# In-memory fallback is used when UPSTASH_REDIS_REST_URL is not set.
# Create a free instance at https://console.upstash.com
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# -- Error Tracking (Sentry) -------------------------------------------------
# Create a Sentry project at https://sentry.io (free tier: 5K events/month).
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# Required for sourcemap upload during build (without it, stack traces are minified).
SENTRY_AUTH_TOKEN=""

# -- Analytics (Google Analytics) --------------------------------------------
# Standard GA4 measurement ID (format: G-XXXXXXXXXX).
NEXT_PUBLIC_GA_ID=""

# -- Development Only --------------------------------------------------------
# Set to "1" to enable Prisma query logging in dev mode.
# PRISMA_LOG_QUERIES="1"


# =============================================================================
# DEPLOYMENT CHECKLIST
# =============================================================================
# 1. Set these variables in Vercel Dashboard: Settings → Environment Variables
# 2. Ensure NEXT_PUBLIC_APP_URL points to your actual Vercel URL
# 3. After deploy, run: npm run db:seed to create Admin User + showroom data
# 4. Log in to /admin and change the password immediately
# =============================================================================
